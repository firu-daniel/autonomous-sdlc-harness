# Push notifications for an unattended run — EXAMPLE FILE. No real value belongs in it.
#
# Copy this file to `.claude/push-notify.env` — the path `devscene.config.json` holds in
# `pushEnvPath` — fill the values in there, and keep that copy out of version control;
# `devscene init` adds the ignore line for it. Only the *path* is
# configuration. The contents are machine-local: they never go into `devscene.config.json`,
# a plan, a review finding or a commit message, and this example file is the only one of
# the pair that is committed.
#
# Key names are the harness's own and are prefixed `DEVSCENE_PUSH_`; the reader
# recognises these spellings and no others.

# Where a run posts its notifications: any endpoint that accepts an HTTP POST.
# Leave it empty to send none.
DEVSCENE_PUSH_URL=

# Optional. A local command run in addition to the POST — a desktop notifier, a chat
# client's own command-line tool. It receives the message on standard input.
DEVSCENE_PUSH_CMD=
