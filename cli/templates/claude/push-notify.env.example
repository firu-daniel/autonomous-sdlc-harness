# Push notifications for an unattended run — EXAMPLE FILE. No real value belongs in it.
#
# Copy this file to `{{pushEnvPath}}` — the path `harness.config.json` holds in
# `pushEnvPath` — fill the values in there, and keep that copy out of version control;
# `autonomous-sdlc-harness init` adds the ignore line for it. Only the *path* is
# configuration. The contents are machine-local: they never go into `harness.config.json`,
# a plan, a review finding or a commit message, and this example file is the only one of
# the pair that is committed.
#
# Key names are the harness's own and are prefixed `HARNESS_PUSH_`. They were renamed to
# that prefix when the harness was extracted from the project it grew in, so if you are
# carrying settings over from an earlier runner, rename the keys — the reader recognises
# these spellings and no others.

# Where a run posts its notifications: the full http:// or https:// URL of any endpoint
# that accepts an HTTP POST. Leave it empty to send none.
# For ntfy with no server of your own: install the ntfy app, create a topic there and
# write https://ntfy.sh/<your-topic> here. The topic name works like a password —
# anyone who knows it can read and send these notifications.
# This file is sourced by a shell, so a URL containing shell characters such as `&`
# must be single-quoted: HARNESS_PUSH_URL='https://…?a=1&b=2'.
HARNESS_PUSH_URL=

# Optional. A local command run in addition to the POST — a desktop notifier, a chat
# client's own command-line tool. It receives the message on standard input.
HARNESS_PUSH_CMD=
